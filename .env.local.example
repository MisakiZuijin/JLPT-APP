# Salin file ini menjadi .env.local lalu isi dari
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key

# URL publik aplikasi (di Vercel isi URL produksi, mis. https://nama-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AI Studio > API Keys (untuk fitur AI Gemini)
GEMINI_API_KEY=your-gemini-api-key
